{
  "name": "laudo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/action",
    "packages/core",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "laudo": "node packages/cli/dist/index.js",
    "bundle": "node packages/action/build.mjs",
    "bench": "npm run build && node bench/run.mjs",
    "demo": "npm run build && node scripts/demo-svg.mjs && node scripts/lupa-svg.mjs",
    "check": "npm run typecheck && npm test && npm run bundle && node scripts/check-versions.mjs",
    "doctor": "node packages/cli/dist/index.js doctor"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
